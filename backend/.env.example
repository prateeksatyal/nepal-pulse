# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Either provide DATABASE_URL or individual PG credentials
DATABASE_URL=postgres://postgres:postgres@localhost:5432/warranty_db
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=warranty_db

# Fallback: if USE_IN_MEMORY_DB=true or live PostgreSQL is unreachable,
# the backend gracefully operates with PostgreSQL-compliant in-memory storage (ideal for offline tests & student grading)
USE_IN_MEMORY_DB=false

# Authentication
JWT_SECRET=university_warranty_mgmt_jwt_secret_key_2026
JWT_EXPIRES_IN=7d

# File Upload Settings
MAX_FILE_SIZE_MB=10
UPLOAD_PATH=./uploads

# Supabase Storage Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_secret_key
SUPABASE_RECEIPTS_BUCKET=receipts
SUPABASE_WARRANTY_DOCS_BUCKET=warranty-documents

# Nodemailer Email Configuration
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=demo@ethereal.email
EMAIL_PASS=demo_pass
EMAIL_FROM="Warranty Management <no-reply@warrantymanager.local>"

# Client URL
CLIENT_URL=http://localhost:5173
